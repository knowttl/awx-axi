{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "awx-axi credential profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["origin"],
  "properties": {
    "origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@]+/?$",
      "description": "HTTPS origin without userinfo, path, query or fragment."
    },
    "verifySsl": { "type": "boolean", "default": true },
    "token": {
      "x-secret": true,
      "default": { "env": "AWX_AXI_TOKEN" },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])", "description": "Absolute local path; UNC and device paths are forbidden on Windows." } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stored"],
          "properties": { "stored": { "const": true } }
        }
      ]
    }
  }
}
