{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "awx-axi credential profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["origin"],
  "properties": {
    "origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/\\\\\\s?#@]+/?$",
      "description": "Origin without userinfo, path, query or fragment. HTTP requires allowHttp: true."
    },
    "verifySsl": { "type": "boolean", "default": true },
    "allowHttp": { "type": "boolean", "default": false },
    "token": {
      "x-secret": true,
      "default": { "stored": true },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])", "description": "Absolute local path; UNC and device paths are forbidden on Windows." } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stored"],
          "properties": { "stored": { "const": true } }
        }
      ]
    }
  },
  "if": { "properties": { "allowHttp": { "const": true } }, "required": ["allowHttp"] },
  "else": { "properties": { "origin": { "pattern": "^https://" } } }
}
